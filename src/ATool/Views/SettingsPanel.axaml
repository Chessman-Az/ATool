<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATool.Views.SettingsPanel">
  <StackPanel Margin="20" Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
    <TextBlock Text="数据存储路径" FontWeight="SemiBold" FontSize="14" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Text="{Binding DataPath}" Width="420" />
      <Button Content="迁移数据" Command="{Binding MigrateDataPathCommand}" ToolTip.Tip="将旧路径下全部文件复制到新路径；失败自动回滚（原配置不变）" />
    </StackPanel>
    <TextBlock Text="日志存储路径" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0" />
    <TextBox Text="{Binding LogPath}" Width="420" />
    <TextBlock Text="自动刷新间隔（分钟，最低 5）" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0" />
    <NumericUpDown Value="{Binding RefreshMinutes}" Minimum="5" Maximum="1440" Increment="5" Width="160" />
    <CheckBox IsChecked="{Binding AutoStart}" Content="开机自启（Windows）" Margin="0,8,0,0"
              IsEnabled="{Binding AutoStartSupported}" />
    <TextBlock Text="该功能仅 Windows 支持" Foreground="Gray" FontSize="12"
               IsVisible="{Binding AutoStartSupported, Converter={x:Static BoolConverters.Not}}" />
    <TextBlock Text="桌面提醒浮窗" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0" />
    <CheckBox IsChecked="{Binding FloatEnabled}" Content="开启：鼠标移到屏幕角落弹出全部提醒（仅桌面显示）" />
    <TextBlock Text="浮窗位置" Foreground="Gray" FontSize="12" Margin="0,6,0,0" />
    <ComboBox SelectedIndex="{Binding FloatCorner}" Width="200" Margin="0,2,0,0">
      <ComboBoxItem Content="屏幕左上" />
      <ComboBoxItem Content="屏幕右上" />
      <ComboBoxItem Content="屏幕右下" />
      <ComboBoxItem Content="屏幕左下" />
    </ComboBox>
    <Button Content="保存设置" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Classes="accent" />
    <TextBlock Text="{Binding Message}" Foreground="#2E9E5B" />
  </StackPanel>
</UserControl>
