<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ATool.Views"
             x:Class="ATool.Views.ReminderCalendarPanel">
  <UserControl.Resources>
    <views:CalendarDayBrushConverter x:Key="DayBrush" />
  </UserControl.Resources>
  <Border Background="{DynamicResource CardBrush}" CornerRadius="10"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
    <DockPanel>
      <!-- 月份导航 -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16"
                  HorizontalAlignment="Center" Margin="0,0,0,12">
        <Button Content="◀" Command="{Binding PrevMonthCommand}" Padding="12,5" CornerRadius="6" />
        <TextBlock Text="{Binding MonthTitle}" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" MinWidth="104" TextAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <Button Content="▶" Command="{Binding NextMonthCommand}" Padding="12,5" CornerRadius="6" />
      </StackPanel>

      <!-- 星期表头：工作日浅蓝底、周末浅红底 -->
      <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,6">
        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6" Margin="2" Padding="0,5">
          <TextBlock Text="一" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6" Margin="2" Padding="0,5">
          <TextBlock Text="二" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6" Margin="2" Padding="0,5">
          <TextBlock Text="三" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6" Margin="2" Padding="0,5">
          <TextBlock Text="四" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6" Margin="2" Padding="0,5">
          <TextBlock Text="五" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <Border Background="#FDECEC" CornerRadius="6" Margin="2" Padding="0,5">
          <TextBlock Text="六" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#D64545" />
        </Border>
        <Border Background="#FDECEC" CornerRadius="6" Margin="2" Padding="0,5">
          <TextBlock Text="日" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#D64545" />
        </Border>
      </UniformGrid>

      <!-- 日历网格（42 格）：今天红色高亮、选中主色高亮、有提醒的日期带标记点 -->
      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding SelectCommand}" Background="Transparent" BorderThickness="0"
                    Padding="2" Margin="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    IsEnabled="{Binding HasDate}" CornerRadius="8">
              <Button.Styles>
                <!-- 非当月（disabled）格子：背景/边框/内容全透明，不留黑框 -->
                <Style Selector="Button:disabled /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
              </Button.Styles>
              <Border MinWidth="34" Height="32" CornerRadius="8" Padding="0,2" IsVisible="{Binding HasDate}">
                <Border.Background>
                  <MultiBinding Converter="{StaticResource DayBrush}" ConverterParameter="bg">
                    <Binding Path="IsSelected" />
                    <Binding Path="IsToday" />
                  </MultiBinding>
                </Border.Background>
                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DayNumberText}" FontSize="12" TextAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Foreground>
                      <MultiBinding Converter="{StaticResource DayBrush}" ConverterParameter="fg">
                        <Binding Path="IsSelected" />
                        <Binding Path="IsToday" />
                      </MultiBinding>
                    </TextBlock.Foreground>
                  </TextBlock>
                  <Ellipse Width="4" Height="4" HorizontalAlignment="Center" IsVisible="{Binding IsMarked}">
                    <Ellipse.Fill>
                      <MultiBinding Converter="{StaticResource DayBrush}" ConverterParameter="dot">
                        <Binding Path="IsSelected" />
                        <Binding Path="IsToday" />
                      </MultiBinding>
                    </Ellipse.Fill>
                  </Ellipse>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>
  </Border>
</UserControl>
