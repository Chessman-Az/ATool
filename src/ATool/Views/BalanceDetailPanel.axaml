<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ATool.Views"
             x:Class="ATool.Views.BalanceDetailPanel">
  <UserControl.Resources>
    <views:DeltaBrushConverter x:Key="DeltaBrush" />
    <views:DeltaBackgroundBrushConverter x:Key="DeltaBg" />
  </UserControl.Resources>
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="余额变动明细" Classes="h2" Margin="2,0,0,8" />
    <TextBlock Text="{Binding EmptyHint}" Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding HasRows, Converter={x:Static BoolConverters.Not}}" />
    <ScrollViewer IsVisible="{Binding HasRows}">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
              <Border Background="#101C30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,3">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding QueriedAt}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding Alias}" Classes="hint" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Balance, StringFormat='¥{0:F2}'}" FontWeight="Bold" FontSize="14"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <!-- 变动金额：彩色圆角标签（增绿/减红/持平灰） -->
                  <Border CornerRadius="5" Padding="7,2" VerticalAlignment="Center"
                          Background="{Binding DeltaText, Converter={StaticResource DeltaBg}}">
                    <TextBlock Text="{Binding DeltaText}" FontWeight="Bold" FontSize="12"
                               Foreground="{Binding DeltaText, Converter={StaticResource DeltaBrush}}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
