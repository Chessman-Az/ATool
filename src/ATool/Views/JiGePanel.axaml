<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATool.Views.JiGePanel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="180,*" ColumnSpacing="14" Margin="4">

      <!-- 左：大分类 -->
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="10">
        <StackPanel Spacing="2">
          <TextBlock Text="机哥 · 工具舱" Classes="hint" Margin="10,8,10,12" />
          <RadioButton x:Name="RbHardware" Content="🖥️ 硬件信息" GroupName="JiGeNav" IsChecked="True"
                       FontSize="15" FontWeight="SemiBold" Margin="10,6" Padding="8,8" />
          <RadioButton x:Name="RbDisk" Content="💽 磁盘工具" GroupName="JiGeNav"
                       FontSize="15" FontWeight="SemiBold" Margin="10,6" Padding="8,8" />
          <RadioButton x:Name="RbOther" Content="🧰 其他工具" GroupName="JiGeNav"
                       FontSize="15" FontWeight="SemiBold" Margin="10,6" Padding="8,8" />
        </StackPanel>
      </Border>

      <!-- 右：页面 -->
      <StackPanel Grid.Column="1" Spacing="10">

        <!-- 硬件信息 -->
        <Border IsVisible="{Binding #RbHardware.IsChecked}"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18,14">
          <StackPanel Spacing="10">
            <TextBlock Text="🖥️ 硬件信息" FontWeight="Bold" FontSize="15" />
            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding Manufacturer}" Classes="hint" FontSize="11" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding OsName}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="构建 {Binding OsBuild} · {Binding Arch}" Classes="hint" FontSize="11" />
                <TextBlock Text="运行时间：{Binding Uptime}" FontSize="12"
                           Foreground="{DynamicResource PrimaryBrush}" />
              </StackPanel>
            </Grid>

            <!-- 硬件分类卡片：CPU / 内存 / 显卡 / 硬盘 / 显示器 / 网卡 -->
            <WrapPanel>
              <Border Width="250" Background="#101C30" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="🧠 CPU" FontWeight="Bold" FontSize="13" Foreground="#7DD3FC" />
                  <TextBlock Text="{Binding Processor}" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CpuCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding CpuClock}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </Border>
              <Border Width="250" Background="#101C30" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="💾 内存" FontWeight="Bold" FontSize="13" Foreground="#34D399" />
                  <TextBlock Text="{Binding TotalMemoryGb}" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="逻辑处理器 {Binding CpuCount}" FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </Border>
              <Border Width="250" Background="#101C30" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="🖥️ 显卡" FontWeight="Bold" FontSize="13" Foreground="#FBBF24" />
                  <ItemsControl ItemsSource="{Binding Gpus}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Width="250" Background="#101C30" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="💽 硬盘" FontWeight="Bold" FontSize="13" Foreground="#7DD3FC" />
                  <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Width="250" Background="#101C30" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="🖵 显示器" FontWeight="Bold" FontSize="13" Foreground="#F87171" />
                  <ItemsControl ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Width="250" Background="#101C30" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,10,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="🌐 网卡" FontWeight="Bold" FontSize="13" Foreground="#A78BFA" />
                  <ItemsControl ItemsSource="{Binding Nets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- 磁盘工具 -->
        <Border IsVisible="{Binding #RbDisk.IsChecked}"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18,14">
          <StackPanel Spacing="10">
            <TextBlock Text="💽 磁盘工具（内置官方便携版，无需安装）" FontWeight="Bold" FontSize="15" />
            <ItemsControl ItemsSource="{Binding DiskTools}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="150" Height="160" Background="#101C30"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="12" Margin="0,0,10,10">
                    <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border Width="58" Height="58" CornerRadius="12" Background="#1A2B45"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="42" Height="42" Stretch="Uniform" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                 HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="132" />
                      <TextBlock Text="{Binding Note}" FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center" TextAlignment="Center"
                                 TextWrapping="Wrap" MaxWidth="132" MaxHeight="26" />
                      <TextBlock Text="{Binding StatusText}" FontSize="10" HorizontalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Button Content="启动" Command="{Binding LaunchCommand}" Classes="accent"
                                FontSize="10" Padding="12,3" />
                        <Button Content="官网" Command="{Binding OpenOfficialCommand}"
                                FontSize="10" Padding="12,3" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 其他工具 -->
        <Border IsVisible="{Binding #RbOther.IsChecked}"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18,14">
          <StackPanel Spacing="10">
            <TextBlock Text="🧰 其他工具（内置官方便携版，无需安装）" FontWeight="Bold" FontSize="15" />
            <ItemsControl ItemsSource="{Binding OtherTools}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="150" Height="160" Background="#101C30"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="12" Margin="0,0,10,10">
                    <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border Width="58" Height="58" CornerRadius="12" Background="#1A2B45"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="42" Height="42" Stretch="Uniform" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                 HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="132" />
                      <TextBlock Text="{Binding Note}" FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center" TextAlignment="Center"
                                 TextWrapping="Wrap" MaxWidth="132" MaxHeight="26" />
                      <TextBlock Text="{Binding StatusText}" FontSize="10" HorizontalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Button Content="启动" Command="{Binding LaunchCommand}" Classes="accent"
                                FontSize="10" Padding="12,3" />
                        <Button Content="官网" Command="{Binding OpenOfficialCommand}"
                                FontSize="10" Padding="12,3" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
