<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ATool.Views"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="660"
        x:Class="ATool.Views.MainWindow"
        Title="A工具"
        Width="980" Height="660"
        MinWidth="760" MinHeight="500"
        Icon="/Assets/icon.ico">

  <Window.Resources>
    <views:EnumEqualsConverter x:Key="NavEq" />
  </Window.Resources>

  <DockPanel>
    <!-- 顶部品牌栏 -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="16,10">
      <DockPanel>
        <TextBlock Text="A工具" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Right" Text="正在刷新余额…" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12"
                   IsVisible="{Binding IsRefreshing}" />
      </DockPanel>
    </Border>

    <!-- 左侧导航 + 右侧内容 -->
    <Grid Margin="12,10,12,12" ColumnDefinitions="180,*">
      <!-- 左导航列 -->
      <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="10"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="功能导航" Classes="hint" Margin="12,6,12,8" />
          <ListBox SelectedIndex="{Binding NavIndex}" Background="Transparent" FontSize="14">
            <ListBoxItem Content="提醒事项" />
            <ListBoxItem Content="DeepSeek 余额" />
            <ListBoxItem Content="系统设置" />
            <ListBoxItem Content="A工具" />
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 右侧内容区（按 NavIndex 切换）；窗口缩小时纵向滚动，避免文字错位/裁剪 -->
      <Grid Grid.Column="1" Margin="12,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <!-- 提醒事项：日历（上）+ 列表/编辑（下） -->
        <Grid IsVisible="{Binding NavIndex, Converter={StaticResource NavEq}, ConverterParameter=0}">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
              <views:ReminderCalendarPanel DataContext="{Binding Calendar}" />
            </Border>
            <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="3*,2*">
              <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" Padding="8">
                <views:ReminderListView DataContext="{Binding Reminders}" />
              </Border>
              <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      IsVisible="{Binding Reminders.IsEditorOpen}">
                <views:ReminderEditorPanel DataContext="{Binding Reminders.Editor}" />
              </Border>
            </Grid>
          </Grid>
        </Grid>
        </Grid>
        </ScrollViewer>

        <!-- DeepSeek 余额：开干 → 全部余额 → Key 列表 → 图表(左)+明细(右)；直接填充视口，全屏时图表区拉伸填满 -->
        <Grid IsVisible="{Binding NavIndex, Converter={StaticResource NavEq}, ConverterParameter=1}"
              RowDefinitions="Auto,Auto,Auto,*">
            <Border Grid.Row="0" Margin="0,0,0,8" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8">
              <views:PeakHourPanel DataContext="{Binding PeakHour}" />
            </Border>
            <Border Grid.Row="1" Margin="0,0,0,4" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,8">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="全部余额" Classes="h2" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ApiKeys.TotalBalance, StringFormat='¥{0:F2}'}" FontSize="17"
                             FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 每个别名一个长方形框，自动换行 -->
                <ItemsControl ItemsSource="{Binding ApiKeys.Keys}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="200" Background="{DynamicResource PrimarySoftBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              CornerRadius="8" Padding="14,7" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Alias}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding BalanceText, StringFormat='¥{0}'}" FontSize="13" FontWeight="Bold"
                                     Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Margin="0,0,0,2" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6">
              <views:ApiKeyPanel DataContext="{Binding ApiKeys}" />
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="1*,1*">
              <Border MinHeight="240" Background="{DynamicResource CardBrush}" CornerRadius="10"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
                <views:BalanceChartView DataContext="{Binding Chart}" />
              </Border>
              <Border Grid.Column="1" Margin="10,0,0,0" MinHeight="240" Background="{DynamicResource CardBrush}"
                      CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                <views:BalanceDetailPanel DataContext="{Binding BalanceDetail}" />
              </Border>
            </Grid>

          <!-- 刷新中：界面中央旋转圆圈（半透明遮罩 + 代码驱动的旋转圆环）；遮罩不拦截点击 -->
          <Grid Grid.RowSpan="4" Background="#33FFFFFF" IsVisible="{Binding IsRefreshing}" IsHitTestVisible="False">
            <Path x:Name="RefreshSpinner" Width="46" Height="46" Stroke="{DynamicResource PrimaryBrush}"
                  StrokeThickness="5" StrokeDashArray="28,44" StrokeLineCap="Round"
                  RenderTransformOrigin="50%,50%" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path.Data>
                <EllipseGeometry RadiusX="20" RadiusY="20" />
              </Path.Data>
              <Path.RenderTransform>
                <RotateTransform Angle="0" />
              </Path.RenderTransform>
            </Path>
          </Grid>
        </Grid>

        <!-- 系统设置 -->
        <Border IsVisible="{Binding NavIndex, Converter={StaticResource NavEq}, ConverterParameter=2}"
                Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="4">
          <views:SettingsPanel DataContext="{Binding Settings}" />
        </Border>

        <!-- A工具（关于页）：居中卡片 -->
        <Border IsVisible="{Binding NavIndex, Converter={StaticResource NavEq}, ConverterParameter=3}"
                Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="40">
          <Border Background="#FAFBFD" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="14" Padding="44,34" MaxWidth="440"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="0">
              <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource PrimaryBrush}"
                      HorizontalAlignment="Center">
                <TextBlock Text="A" FontSize="40" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="A工具" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,4" />
              <TextBlock Text="版本 9" Classes="hint" HorizontalAlignment="Center" FontSize="13" />
              <TextBlock Text="作者：小泽" Classes="hint" HorizontalAlignment="Center" FontSize="13" Margin="0,3,0,0" />
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,16" />
              <TextBlock Text="灵活重复规则的本地提醒事项，加上 DeepSeek 多 API Key 余额监控的桌面小工具。"
                         Classes="hint" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
