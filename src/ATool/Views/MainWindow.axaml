<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ATool.Views"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="660"
        x:Class="ATool.Views.MainWindow"
        Title="A工具"
        Width="980" Height="660"
        MinWidth="760" MinHeight="500"
        Icon="/Assets/icon.ico">

  <Window.Resources>
    <views:EnumEqualsConverter x:Key="NavEq" />
  </Window.Resources>

  <DockPanel>
    <!-- 顶部品牌栏 -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="16,10">
      <DockPanel>
        <TextBlock Text="A工具" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Right" Text="正在刷新余额…" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12"
                   IsVisible="{Binding IsRefreshing}" />
      </DockPanel>
    </Border>

    <!-- 左侧导航 + 右侧内容 -->
    <Grid Margin="12,10,12,12" ColumnDefinitions="180,*">
      <!-- 左导航列 -->
      <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="10"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="功能导航" Classes="hint" Margin="12,6,12,8" />
          <ListBox SelectedIndex="{Binding NavIndex}" Background="Transparent" FontSize="14">
            <ListBoxItem Content="提醒事项" />
            <ListBoxItem Content="DeepSeek 余额" />
            <ListBoxItem Content="系统设置" />
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 右侧内容区（按 NavIndex 切换） -->
      <Grid Grid.Column="1" Margin="12,0,0,0">
        <!-- 提醒事项：日历（上）+ 列表/编辑（下） -->
        <Grid IsVisible="{Binding NavIndex, Converter={StaticResource NavEq}, ConverterParameter=0}">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
              <views:ReminderCalendarPanel DataContext="{Binding Calendar}" />
            </Border>
            <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="3*,2*">
              <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" Padding="8">
                <views:ReminderListView DataContext="{Binding Reminders}" />
              </Border>
              <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      IsVisible="{Binding Reminders.IsEditorOpen}">
                <views:ReminderEditorPanel DataContext="{Binding Reminders.Editor}" />
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <!-- DeepSeek 余额：开干 → 全部余额 → Key 列表 → 选中 Key 的图表(左)+明细(右) -->
        <Grid IsVisible="{Binding NavIndex, Converter={StaticResource NavEq}, ConverterParameter=1}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8">
              <views:PeakHourPanel DataContext="{Binding PeakHour}" />
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,8">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="全部余额" Classes="h2" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ApiKeys.TotalBalance, StringFormat='¥{0:F2}'}" FontSize="17"
                             FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ApiKeys.Keys}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Alias}" Classes="hint" />
                        <TextBlock Text="{Binding BalanceText, StringFormat='¥{0}'}" Classes="hint"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" MaxHeight="220">
              <views:ApiKeyPanel DataContext="{Binding ApiKeys}" />
            </Border>
            <Grid ColumnDefinitions="1*,1*">
              <Border MaxHeight="300" Background="{DynamicResource CardBrush}" CornerRadius="10"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
                <views:BalanceChartView DataContext="{Binding Chart}" />
              </Border>
              <Border Grid.Column="1" Margin="10,0,0,0" MaxHeight="300" Background="{DynamicResource CardBrush}"
                      CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                <views:BalanceDetailPanel DataContext="{Binding BalanceDetail}" />
              </Border>
            </Grid>
          </DockPanel>

          <!-- 刷新中：界面中央旋转圆圈（半透明遮罩 + 代码驱动的旋转圆环） -->
          <Grid Background="#33FFFFFF" IsVisible="{Binding IsRefreshing}">
            <Path x:Name="RefreshSpinner" Width="46" Height="46" Stroke="{DynamicResource PrimaryBrush}"
                  StrokeThickness="5" StrokeDashArray="28,44" StrokeLineCap="Round"
                  RenderTransformOrigin="50%,50%" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path.Data>
                <EllipseGeometry RadiusX="20" RadiusY="20" />
              </Path.Data>
              <Path.RenderTransform>
                <RotateTransform Angle="0" />
              </Path.RenderTransform>
            </Path>
          </Grid>
        </Grid>

        <!-- 系统设置 -->
        <Border IsVisible="{Binding NavIndex, Converter={StaticResource NavEq}, ConverterParameter=2}"
                Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="4">
          <views:SettingsPanel DataContext="{Binding Settings}" />
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
