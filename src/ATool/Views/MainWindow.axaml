<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ATool.Views"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="660"
        x:Class="ATool.Views.MainWindow"
        Title="A工具"
        Width="980" Height="660"
        MinWidth="760" MinHeight="500"
        Icon="/Assets/icon.ico">

  <Window.Resources>
    <views:BoolToPeakBrushConverter x:Key="PeakBrush" />
  </Window.Resources>

  <DockPanel>
    <!-- 顶部品牌栏 -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="16,10">
      <DockPanel>
        <TextBlock Text="A工具" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
          <Button Content="{Binding PeakStatusText}" FontSize="13" FontWeight="Bold"
                  Background="White" Foreground="{DynamicResource PrimaryBrush}"
                  Padding="16,6" Command="{Binding RefreshBalanceCommand}"
                  ToolTip.Tip="DeepSeek 计价状态（点击刷新全部余额）" />
          <TextBlock Text="正在刷新余额…" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12"
                     IsVisible="{Binding IsRefreshing}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 内容区 -->
    <TabControl Margin="12,10,12,12">
      <TabItem Header="提醒事项">
        <Grid ColumnDefinitions="3*,2*">
          <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
            <views:ReminderListView DataContext="{Binding Reminders}" />
          </Border>
          <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  IsVisible="{Binding Reminders.IsEditorOpen}">
            <views:ReminderEditorPanel DataContext="{Binding Reminders.Editor}" />
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="DeepSeek 余额">
        <DockPanel>
          <Border DockPanel.Dock="Top" Margin="0,0,0,10" Background="{DynamicResource CardBrush}" CornerRadius="10"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8">
            <views:PeakHourPanel DataContext="{Binding PeakHour}" />
          </Border>
          <Grid ColumnDefinitions="5*,7*">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
              <views:ApiKeyPanel DataContext="{Binding ApiKeys}" />
            </Border>
            <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
              <views:BalanceChartView DataContext="{Binding Chart}" />
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="系统设置">
        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
          <views:SettingsPanel DataContext="{Binding Settings}" />
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
