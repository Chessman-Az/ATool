<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ATool.Views.ReminderPopupWindow"
        Title="提醒"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="560" MaxHeight="520"
        Icon="/Assets/icon.ico">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />
    <ScrollViewer MaxHeight="420">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Item.Reminder.Title}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="{Binding DisplayTime}" Foreground="Gray" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding MissedText}" Foreground="#E6A23C" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Item.Reminder.Description}" TextWrapping="Wrap" Foreground="#88000000"
                           IsVisible="{Binding Item.Reminder.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="完成" Command="{Binding CompleteCommand}" />
                  <Button Content="延迟 5 分钟" Command="{Binding Snooze5Command}" />
                  <Button Content="15" Command="{Binding Snooze15Command}" />
                  <Button Content="30" Command="{Binding Snooze30Command}" />
                  <Button Content="60" Command="{Binding Snooze60Command}" />
                  <TextBox x:Name="CustomBox" Width="64" Watermark="分钟" />
                  <Button Content="延迟" Command="{Binding SnoozeCustomCommand}" CommandParameter="{Binding #CustomBox.Text}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</Window>
