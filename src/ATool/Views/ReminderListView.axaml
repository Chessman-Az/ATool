<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATool.Views.ReminderListView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Margin="12,12,12,10" Padding="10"
            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource CardRadius}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="待提醒" Command="{Binding FilterPendingCommand}" Classes="accent" />
        <Button Content="已完成" Command="{Binding FilterDoneCommand}" />
        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Classes="hint"
                   Text="{Binding Items.Count, StringFormat='共 {0} 条'}" />
        <Button Content="＋ 添加" Command="{Binding AddCommand}" HorizontalAlignment="Right" Margin="16,0,0,0" Classes="accent" />
        <Button Content="编辑" Command="{Binding EditCommand}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="删除" Command="{Binding DeleteCommand}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="danger" />
      </StackPanel>
    </Border>
    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="6,0,6,6">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,3">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <!-- 圆圈：未完成=空心圆可点击完成；已完成=绿色实心对勾 -->
              <Button Grid.Column="0" Command="{Binding CompleteCommand}" Background="Transparent"
                      BorderThickness="0" Padding="6,2" VerticalAlignment="Center"
                      IsVisible="{Binding IsDone, Converter={x:Static BoolConverters.Not}}"
                      ToolTip.Tip="点击标记完成">
                <Ellipse Width="16" Height="16" Stroke="{DynamicResource TextSecondaryBrush}"
                         StrokeThickness="1.5" Fill="Transparent" />
              </Button>
              <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                      Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                      IsVisible="{Binding IsDone}">
                <TextBlock Text="✓" FontSize="11" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Classes="hint" Foreground="{DynamicResource PrimaryBrush}" Text="{Binding RepeatText}" />
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <TextBlock Text="{Binding TriggerTime}" Classes="hint" />
                  <TextBlock Text="{Binding TriggeredCountText}" Classes="hint" />
                </StackPanel>
              </StackPanel>
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="hint" Text="{Binding StatusText}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
