<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ATool.Views"
             x:Class="ATool.Views.ReminderEditorPanel">
  <UserControl.Resources>
    <views:EnumEqualsConverter x:Key="EnumEq" />
  </UserControl.Resources>
  <Border BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" Margin="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16" Spacing="10">
        <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding EditorTitle}" />

        <TextBox Text="{Binding Title}" Watermark="标题（必填）" />
        <TextBox Text="{Binding Description}" Watermark="描述（可选）" AcceptsReturn="True" Height="64" />

        <TextBlock Text="重复规则" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <RadioButton Content="单次" IsChecked="{Binding IsSingle}" GroupName="RepeatType" />
          <RadioButton Content="每日" IsChecked="{Binding IsDaily}" GroupName="RepeatType" />
          <RadioButton Content="自定义每周几" IsChecked="{Binding IsWeekly}" GroupName="RepeatType" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding RepeatType, Converter={StaticResource EnumEq}, ConverterParameter=Weekly}">
          <TextBlock Text="触发时间（HH:mm:ss）" VerticalAlignment="Center" />
          <TextBox Text="{Binding TriggerTime}" Width="110" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding WeeklyItems}"
                      IsVisible="{Binding RepeatType, Converter={StaticResource EnumEq}, ConverterParameter=Weekly}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Width="80" />
                <TextBox Text="{Binding Time}" Width="100" IsEnabled="{Binding IsSelected}" Watermark="HH:mm:ss" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="结束条件" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <RadioButton Content="永不结束" IsChecked="{Binding IsNever}" GroupName="EndType" />
          <RadioButton Content="截止日期" IsChecked="{Binding IsDate}" GroupName="EndType" />
          <RadioButton Content="触发次数" IsChecked="{Binding IsTimes}" GroupName="EndType" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding EndType, Converter={StaticResource EnumEq}, ConverterParameter=Date}">
          <TextBlock Text="截止日期（yyyy-MM-dd）" VerticalAlignment="Center" />
          <TextBox Text="{Binding EndValue}" Width="130" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding EndType, Converter={StaticResource EnumEq}, ConverterParameter=Times}">
          <TextBlock Text="触发次数（正整数）" VerticalAlignment="Center" />
          <TextBox Text="{Binding EndValue}" Width="100" />
        </StackPanel>

        <TextBlock Text="{Binding Error}" Foreground="#D64545" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="保存" Command="{Binding SaveCommand}" Classes="accent" />
          <Button Content="取消" Command="{Binding CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
