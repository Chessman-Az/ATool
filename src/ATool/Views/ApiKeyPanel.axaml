<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATool.Views.ApiKeyPanel">
  <DockPanel Margin="12,12,12,4">
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding NewAlias}" Watermark="别名（如：个人主Key）" Width="170" />
        <TextBox Text="{Binding NewKey}" Watermark="sk-…（添加时自动验证）" Width="300" />
        <Button Content="添加 Key" Command="{Binding AddKeyCommand}" Classes="accent" />
        <Button Content="立即刷新全部" Classes="accent"
                Click="OnRefreshAllClick" />
      </StackPanel>
      <TextBlock Text="{Binding Message}" Classes="danger" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 每个 Key 一个长方形框（WrapPanel 自动换行，不滚动）；点击框选中 → 图表/明细联动 -->
    <ListBox ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="2" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Width="330" Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="12,8">
            <DockPanel>
              <!-- 右侧：独立刷新 + 删除 -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="刷新" Command="{Binding RefreshCommand}"
                        FontSize="11" Padding="10,4" />
                <Button Content="删除" Command="{Binding DeleteCommand}" Classes="danger"
                        FontSize="11" Padding="10,4" />
              </StackPanel>
              <!-- 左侧：信息 -->
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding BalanceText, StringFormat='余额 ¥{0}'}" FontSize="13"
                             Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DeltaText}" Classes="hint" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding LastError}" Classes="danger" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
