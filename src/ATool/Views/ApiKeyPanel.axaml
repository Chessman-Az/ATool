<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATool.Views.ApiKeyPanel">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding NewAlias}" Watermark="别名（如：个人主Key）" Width="160" />
        <TextBox Text="{Binding NewKey}" Watermark="sk-…（添加时自动验证）" Width="320" />
        <Button Content="添加 Key" Command="{Binding AddKeyCommand}" Classes="accent" />
        <Button Content="立即刷新全部" Command="{Binding RefreshAsyncCommand}" IsEnabled="{Binding IsRefreshing, Converter={x:Static BoolConverters.Not}}" />
      </StackPanel>
      <TextBlock Text="{Binding Message}" Foreground="#D64545" TextWrapping="Wrap" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Keys}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Spacing="3" Margin="4,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="{Binding BalanceText, StringFormat='余额 ¥{0}'}" FontSize="14" />
              <TextBlock Text="{Binding DeltaText, StringFormat='({0})'}" Foreground="Gray" />
              <TextBlock Text="{Binding LastError}" Foreground="#D64545" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding CreatedAt, StringFormat='添加于 {0}'}" Foreground="Gray" FontSize="11" />
              <Button Content="删除" Command="{Binding DeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
