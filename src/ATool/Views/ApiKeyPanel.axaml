<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATool.Views.ApiKeyPanel">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding NewAlias}" Watermark="别名（如：个人主Key）" Width="170" />
        <TextBox Text="{Binding NewKey}" Watermark="sk-…（添加时自动验证）" Width="300" />
        <Button Content="添加 Key" Command="{Binding AddKeyCommand}" Classes="accent" />
        <Button Content="立即刷新全部" Command="{Binding RefreshAsyncCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Message}" Classes="danger" TextWrapping="Wrap" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,2">
            <!-- 左侧：信息 -->
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding BalanceText, StringFormat='余额 ¥{0}'}" FontSize="14"
                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DeltaText, StringFormat='({0})'}" Classes="hint" />
              </StackPanel>
              <TextBlock Text="{Binding LastError}" Classes="danger" TextWrapping="Wrap" />
            </StackPanel>
            <!-- 右侧：独立刷新 + 删除（最右） -->
            <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}"
                    FontSize="11" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="删除" Command="{Binding DeleteCommand}" Classes="danger"
                    FontSize="11" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
