<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ATool.Views.PeakHourWindow"
        Title="DeepSeek 峰谷计价" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock FontSize="17" FontWeight="Bold">
      <Run Text="当前时段：" /><Run Text="{Binding StatusText}" FontWeight="Bold" />
    </TextBlock>
    <TextBlock Text="北京时间每日 9:00-12:00 与 14:00-18:00 为高峰时段，API 价格为平时的 2 倍。" TextWrapping="Wrap" Foreground="Gray" />
    <ItemsControl ItemsSource="{Binding Periods}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="80,80,*,Auto" Margin="0,4">
            <TextBlock Text="{Binding Start, StringFormat='{}{0} 起'}" />
            <TextBlock Text="{Binding End, StringFormat='至 {0}'}" Grid.Column="1" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <TextBlock Text="高峰时段" FontWeight="SemiBold" Foreground="#D64545" IsVisible="{Binding IsPeak}" />
              <TextBlock Text="低谷时段" FontWeight="SemiBold" Foreground="#2E9E5B"
                         IsVisible="{Binding IsPeak, Converter={x:Static BoolConverters.Not}}" />
            </StackPanel>
            <TextBlock Grid.Column="3" Foreground="Gray" Text="{Binding DisplayMultiplier}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
      <TextBlock Text="{Binding PriceCompareText}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</Window>
