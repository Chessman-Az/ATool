<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ATool.Views.FloatReminderWindow"
        Width="260" Height="320"
        SystemDecorations="None"
        ShowInTaskbar="False" Topmost="False" CanResize="False"
        ShowActivated="False" Focusable="False"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <Border x:Name="RootBorder" Background="White" BorderBrush="#E4E8F0" BorderThickness="1" CornerRadius="12" Margin="3">
    <Grid>
      <TextBlock x:Name="EmptyText" Text="暂无待办提醒" Classes="hint"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ListBox x:Name="ReminderList" Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="Transparent" BorderBrush="#E4E8F0" BorderThickness="1"
                    CornerRadius="8" Padding="10,7" Margin="4,3">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 待办圆圈（与主窗口提醒列表一致：空心圆 = 未完成） -->
                <Ellipse Width="11" Height="11" Stroke="{DynamicResource PrimaryBrush}"
                         StrokeThickness="1.6" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"
                           Foreground="#1F2430" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</Window>
