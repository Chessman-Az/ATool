<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ATool.Views"
        x:Class="ATool.Views.FloatReminderWindow"
        Width="260" Height="320"
        SystemDecorations="None"
        ShowInTaskbar="False" Topmost="False" CanResize="False"
        ShowActivated="False" Focusable="False"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <Window.Resources>
    <views:BoolToTextDecorationsConverter x:Key="StrikeConv" />
  </Window.Resources>
  <Border x:Name="RootBorder" Background="White" BorderBrush="#E4E8F0" BorderThickness="1" CornerRadius="12" Margin="3">
    <Grid>
      <TextBlock x:Name="EmptyText" Text="暂无待办提醒" Classes="hint"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ListBox x:Name="ReminderList" Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <!-- 列表项紧凑排列（覆盖全局 ListBoxItem 的 12,9 Padding——它才是框间距主源） -->
          <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0,0" />
            <Setter Property="Padding" Value="0" />
          </Style>
          <!-- hover 只高亮卡片本身；列表项整行不泛蓝 -->
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:pointerover Border.card">
            <Setter Property="Background" Value="#F0F4FF" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Background="Transparent" BorderBrush="#E4E8F0" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" Margin="4,4">
              <!-- Margin 上下 4px ×2 = 框与框之间 8px 间隙（间隙由 Margin 控制，不是 Padding） -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 待办圆圈：未完成空心蓝 / 已完成实心绿；点击切换完成状态 -->
                <Button Click="OnCircleClick" Background="Transparent" BorderThickness="0"
                        Padding="2" VerticalAlignment="Center" ToolTip.Tip="点击切换完成状态">
                  <Grid Width="11" Height="11">
                    <Ellipse Stroke="#2E9E5B" StrokeThickness="1.6" Fill="#2E9E5B"
                             IsVisible="{Binding IsDone}" />
                    <Ellipse Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                             IsVisible="{Binding IsDone, Converter={x:Static BoolConverters.Not}}" />
                  </Grid>
                </Button>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13"
                           Foreground="#1F2430" VerticalAlignment="Center"
                           TextDecorations="{Binding IsDone, Converter={StaticResource StrikeConv}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</Window>
