<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ATool"
             x:Class="ATool.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <!-- 品牌色板 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B6FE0" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2F5CC2" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EAF1FE" />
    <SolidColorBrush x:Key="BgBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2430" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E8F0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D64545" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E9E5B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E6A23C" />
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
    <!-- 覆盖 Fluent 系统强调色（选中态/焦点/accent 按钮跟随）——注意：Fluent 期望 Color 类型 -->
    <Color x:Key="SystemAccentColor">#3B6FE0</Color>
    <Color x:Key="SystemAccentColorDark1">#2F5CC2</Color>
    <Color x:Key="SystemAccentColorDark2">#2750A8</Color>
    <Color x:Key="SystemAccentColorDark3">#20448E</Color>
    <Color x:Key="SystemAccentColorLight1">#5C86E6</Color>
    <Color x:Key="SystemAccentColorLight2">#85A6ED</Color>
    <Color x:Key="SystemAccentColorLight3">#ADC6F3</Color>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- ============ 全局控件样式（精致浅色风） ============ -->

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="DatePicker">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="2,2" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F4FF" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Expander">
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Styles>

  <!-- 系统托盘：左键显隐、右键菜单（显示/刷新/退出）。Command 绑定 Application.DataContext（App.axaml.cs 设置） -->
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/icon.ico"
                ToolTipText="A工具"
                Command="{Binding ToggleWindowCommand}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="显示主窗口" Command="{Binding ShowWindowCommand}" />
            <NativeMenuItem Header="立即刷新余额" Command="{Binding RefreshBalanceCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="退出程序" Command="{Binding QuitCommand}" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
